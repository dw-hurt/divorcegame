"""
Divorce Quest - Turn-Based Decision Game with Bayesian Probability
A comprehensive divorce simulation using questionnaires and adaptive AI
"""

import json
import os
from datetime import datetime
from typing import Dict, List, Tuple, Optional
from dataclasses import dataclass, asdict
from enum import Enum
import random


# ============================================================
# CONFIGURATION & ENUMS
# ============================================================

class DivorceStage(Enum):
    """Stages of the divorce process"""
    INITIAL_DECISION = "initial_decision"
    ASSET_DISCOVERY = "asset_discovery"
    NEGOTIATION = "negotiation"
    CUSTODY = "custody"
    LEGAL_PROCESS = "legal_process"
    SETTLEMENT = "settlement"
    POST_DIVORCE = "post_divorce"


class PersonaTrait(Enum):
    """Player personality traits affecting outcomes"""
    COLLABORATIVE = "collaborative"
    COMPETITIVE = "competitive"
    AVOIDANT = "avoidant"
    EMOTIONAL = "emotional"
    RATIONAL = "rational"


# ============================================================
# DATA CLASSES
# ============================================================

@dataclass
class PlayerStats:
    """Player statistics"""
    emotional_wellbeing: int = 50  # 0-100
    financial_security: int = 50   # 0-100
    legal_advantage: int = 50      # 0-100
    relationship_quality: int = 50  # 0-100
    stress_level: int = 50         # 0-100 (lower is better)
    
    def apply_changes(self, changes: Dict[str, int]) -> None:
        """Apply stat changes with bounds checking"""
        for stat, change in changes.items():
            if hasattr(self, stat):
                current = getattr(self, stat)
                new_value = max(0, min(100, current + change))
                setattr(self, stat, new_value)
    
    def get_overall_score(self) -> float:
        """Calculate overall success score"""
        return (
            self.emotional_wellbeing * 0.3 +
            self.financial_security * 0.25 +
            self.legal_advantage * 0.2 +
            self.relationship_quality * 0.15 +
            (100 - self.stress_level) * 0.1
        )


@dataclass
class PlayerPersona:
    """Player personality profile built from questionnaire"""
    primary_trait: PersonaTrait
    secondary_trait: PersonaTrait
    priorities: Dict[str, int]  # What matters most: money, kids, peace, etc.
    risk_tolerance: int  # 0-100
    cooperation_score: int  # 0-100
    
    def get_decision_modifier(self, decision_type: str) -> float:
        """Get personality modifier for decision outcomes"""
        modifiers = {
            PersonaTrait.COLLABORATIVE: {
                'negotiation': 1.2,
                'mediation': 1.3,
                'communication': 1.25
            },
            PersonaTrait.COMPETITIVE: {
                'litigation': 1.2,
                'asset_fight': 1.15,
                'aggressive_stance': 1.25
            },
            PersonaTrait.RATIONAL: {
                'planning': 1.3,
                'financial_analysis': 1.25,
                'strategic': 1.2
            }
        }
        return modifiers.get(self.primary_trait, {}).get(decision_type, 1.0)


@dataclass
class Question:
    """Questionnaire question"""
    id: str
    text: str
    options: List[Dict[str, any]]  # [{'text': '...', 'traits': {...}, 'priority': '...'}]
    category: str


@dataclass
class Scenario:
    """Game scenario/situation"""
    id: str
    stage: DivorceStage
    title: str
    description: str
    context: str  # Additional background info
    choices: List[Dict[str, any]]
    prerequisites: Dict[str, int] = None  # Required stats to unlock
    
    def is_available(self, stats: PlayerStats) -> bool:
        """Check if scenario is available based on stats"""
        if not self.prerequisites:
            return True
        for stat, min_value in self.prerequisites.items():
            if getattr(stats, stat, 0) < min_value:
                return False
        return True


@dataclass
class GameState:
    """Complete game state"""
    player_name: str
    persona: PlayerPersona
    stats: PlayerStats
    current_stage: DivorceStage
    completed_scenarios: List[str]
    turn_number: int
    history: List[Dict]
    
    def save_to_file(self, filename: str) -> None:
        """Save game state to JSON file"""
        data = {
            'player_name': self.player_name,
            'persona': {
                'primary_trait': self.persona.primary_trait.value,
                'secondary_trait': self.persona.secondary_trait.value,
                'priorities': self.persona.priorities,
                'risk_tolerance': self.persona.risk_tolerance,
                'cooperation_score': self.persona.cooperation_score
            },
            'stats': asdict(self.stats),
            'current_stage': self.current_stage.value,
            'completed_scenarios': self.completed_scenarios,
            'turn_number': self.turn_number,
            'history': self.history,
            'saved_at': datetime.now().isoformat()
        }
        
        os.makedirs('saves', exist_ok=True)
        with open(f'saves/{filename}', 'w') as f:
            json.dump(data, f, indent=2)
    
    @staticmethod
    def load_from_file(filename: str) -> 'GameState':
        """Load game state from JSON file"""
        with open(f'saves/{filename}', 'r') as f:
            data = json.load(f)
        
        persona = PlayerPersona(
            primary_trait=PersonaTrait(data['persona']['primary_trait']),
            secondary_trait=PersonaTrait(data['persona']['secondary_trait']),
            priorities=data['persona']['priorities'],
            risk_tolerance=data['persona']['risk_tolerance'],
            cooperation_score=data['persona']['cooperation_score']
        )
        
        stats = PlayerStats(**data['stats'])
        
        return GameState(
            player_name=data['player_name'],
            persona=persona,
            stats=stats,
            current_stage=DivorceStage(data['current_stage']),
            completed_scenarios=data['completed_scenarios'],
            turn_number=data['turn_number'],
            history=data['history']
        )


# ============================================================
# BAYESIAN PROBABILITY ENGINE
# ============================================================

class BayesianPredictor:
    """Predicts outcomes using Bayesian probability based on player choices"""
    
    def __init__(self):
        # Prior probabilities for outcomes
        self.priors = {
            'amicable_settlement': 0.3,
            'contested_divorce': 0.4,
            'high_conflict': 0.2,
            'mediated_success': 0.1
        }
        
        # Likelihood of traits leading to outcomes
        self.likelihoods = {
            PersonaTrait.COLLABORATIVE: {
                'amicable_settlement': 0.7,
                'mediated_success': 0.8,
                'contested_divorce': 0.2,
                'high_conflict': 0.1
            },
            PersonaTrait.COMPETITIVE: {
                'amicable_settlement': 0.2,
                'mediated_success': 0.1,
                'contested_divorce': 0.6,
                'high_conflict': 0.5
            },
            PersonaTrait.RATIONAL: {
                'amicable_settlement': 0.5,
                'mediated_success': 0.6,
                'contested_divorce': 0.3,
                'high_conflict': 0.2
            }
        }
    
    def predict_outcome(self, persona: PlayerPersona, stats: PlayerStats) -> Dict[str, float]:
        """Calculate probability distribution for outcomes"""
        outcomes = {}
        
        for outcome in self.priors.keys():
            # Bayesian update: P(outcome|evidence) ∝ P(evidence|outcome) * P(outcome)
            prior = self.priors[outcome]
            likelihood = self.likelihoods[persona.primary_trait][outcome]
            
            # Adjust based on stats
            stat_modifier = 1.0
            if outcome == 'amicable_settlement':
                stat_modifier = (stats.relationship_quality / 100) * 1.5
            elif outcome == 'high_conflict':
                stat_modifier = (stats.stress_level / 100) * 1.5
            
            # Adjust based on cooperation score
            if outcome in ['amicable_settlement', 'mediated_success']:
                stat_modifier *= (persona.cooperation_score / 100 + 0.5)
            
            outcomes[outcome] = prior * likelihood * stat_modifier
        
        # Normalize to sum to 1
        total = sum(outcomes.values())
        return {k: v/total for k, v in outcomes.items()}
    
    def recommend_action(self, persona: PlayerPersona, stats: PlayerStats, 
                        available_choices: List[Dict]) -> Tuple[Dict, float]:
        """Recommend best action based on predicted outcomes"""
        best_choice = None
        best_score = -1
        
        for choice in available_choices:
            # Simulate applying this choice
            temp_stats = PlayerStats(**asdict(stats))
            temp_stats.apply_changes(choice.get('stat_changes', {}))
            
            # Predict outcomes with this choice
            outcomes = self.predict_outcome(persona, temp_stats)
            
            # Score based on positive outcomes
            score = (
                outcomes.get('amicable_settlement', 0) * 1.0 +
                outcomes.get('mediated_success', 0) * 0.9 -
                outcomes.get('high_conflict', 0) * 0.5
            )
            
            # Apply persona modifier
            if choice.get('type'):
                score *= persona.get_decision_modifier(choice['type'])
            
            if score > best_score:
                best_score = score
                best_choice = choice
        
        return best_choice, best_score


