# QUESTIONNAIRE SYSTEM
# ============================================================

class QuestionnaireSystem:
    """Initial questionnaire to build player persona"""
    
    def __init__(self):
        self.questions = [
            Question(
                id="q1",
                text="What is your primary goal in this divorce?",
                category="priorities",
                options=[
                    {
                        'text': "Maintain a civil relationship with my ex-partner",
                        'traits': {PersonaTrait.COLLABORATIVE: 3, PersonaTrait.EMOTIONAL: 1},
                        'priority': 'relationship',
                        'cooperation': 30
                    },
                    {
                        'text': "Get the best financial outcome possible",
                        'traits': {PersonaTrait.COMPETITIVE: 3, PersonaTrait.RATIONAL: 2},
                        'priority': 'financial',
                        'cooperation': -20
                    },
                    {
                        'text': "Protect my children's wellbeing above all",
                        'traits': {PersonaTrait.EMOTIONAL: 3, PersonaTrait.RATIONAL: 1},
                        'priority': 'children',
                        'cooperation': 10
                    },
                    {
                        'text': "End this as quickly and painlessly as possible",
                        'traits': {PersonaTrait.AVOIDANT: 3, PersonaTrait.RATIONAL: 1},
                        'priority': 'speed',
                        'cooperation': 5
                    }
                ]
            ),
            Question(
                id="q2",
                text="When facing a difficult negotiation, you typically:",
                category="approach",
                options=[
                    {
                        'text': "Seek compromise and win-win solutions",
                        'traits': {PersonaTrait.COLLABORATIVE: 3, PersonaTrait.RATIONAL: 1},
                        'cooperation': 25
                    },
                    {
                        'text': "Stand firm on what you believe you deserve",
                        'traits': {PersonaTrait.COMPETITIVE: 3},
                        'cooperation': -15
                    },
                    {
                        'text': "Try to avoid confrontation if possible",
                        'traits': {PersonaTrait.AVOIDANT: 3},
                        'cooperation': -5
                    },
                    {
                        'text': "Analyze all options logically before deciding",
                        'traits': {PersonaTrait.RATIONAL: 3},
                        'cooperation': 10
                    }
                ]
            ),
            Question(
                id="q3",
                text="How do you handle highly emotional situations?",
                category="emotional",
                options=[
                    {
                        'text': "I try to stay calm and think rationally",
                        'traits': {PersonaTrait.RATIONAL: 3, PersonaTrait.AVOIDANT: 1},
                        'risk_tolerance': 20
                    },
                    {
                        'text': "I express my feelings openly and honestly",
                        'traits': {PersonaTrait.EMOTIONAL: 3, PersonaTrait.COLLABORATIVE: 1},
                        'risk_tolerance': 10
                    },
                    {
                        'text': "I channel emotions into determination",
                        'traits': {PersonaTrait.COMPETITIVE: 2, PersonaTrait.EMOTIONAL: 1},
                        'risk_tolerance': 30
                    },
                    {
                        'text': "I need time alone to process my feelings",
                        'traits': {PersonaTrait.AVOIDANT: 3},
                        'risk_tolerance': -10
                    }
                ]
            ),
            Question(
                id="q4",
                text="Regarding financial matters in the divorce:",
                category="financial",
                options=[
                    {
                        'text': "I'll fight for every dollar I'm entitled to",
                        'traits': {PersonaTrait.COMPETITIVE: 3},
                        'priority': 'financial',
                        'risk_tolerance': 25
                    },
                    {
                        'text': "Fair is fair - I want an equitable split",
                        'traits': {PersonaTrait.RATIONAL: 2, PersonaTrait.COLLABORATIVE: 2},
                        'priority': 'fairness',
                        'cooperation': 20
                    },
                    {
                        'text': "I'm willing to be flexible for peace of mind",
                        'traits': {PersonaTrait.COLLABORATIVE: 2, PersonaTrait.AVOIDANT: 1},
                        'priority': 'peace',
                        'cooperation': 25
                    },
                    {
                        'text': "I'll take less just to end this quickly",
                        'traits': {PersonaTrait.AVOIDANT: 3},
                        'priority': 'speed',
                        'cooperation': 5
                    }
                ]
            ),
            Question(
                id="q5",
                text="Your preferred approach to resolving the divorce:",
                category="resolution",
                options=[
                    {
                        'text': "Mediation - working together with a neutral party",
                        'traits': {PersonaTrait.COLLABORATIVE: 3, PersonaTrait.RATIONAL: 1},
                        'cooperation': 35
                    },
                    {
                        'text': "Litigation - let the courts decide fairly",
                        'traits': {PersonaTrait.COMPETITIVE: 2, PersonaTrait.RATIONAL: 2},
                        'cooperation': -20
                    },
                    {
                        'text': "Collaborative divorce with both attorneys present",
                        'traits': {PersonaTrait.COLLABORATIVE: 2, PersonaTrait.RATIONAL: 2},
                        'cooperation': 20
                    },
                    {
                        'text': "Quick settlement - just get it done",
                        'traits': {PersonaTrait.AVOIDANT: 3},
                        'cooperation': 0
                    }
                ]
            )
        ]
    
    def run_questionnaire(self) -> PlayerPersona:
        """Run the questionnaire and build persona"""
        print("\n" + "="*60)
        print("DIVORCE QUEST - PERSONALITY ASSESSMENT")
        print("="*60)
        print("\nAnswer these questions to help us understand your approach.")
        print("Your answers will shape your journey through the divorce process.\n")
        
        trait_scores = {trait: 0 for trait in PersonaTrait}
        priorities = {}
        total_cooperation = 50  # Start neutral
        total_risk = 50
        
        for i, question in enumerate(self.questions, 1):
            print(f"\nQuestion {i}/{len(self.questions)}:")
            print(f"{question.text}\n")
            
            for j, option in enumerate(question.options, 1):
                print(f"  {j}. {option['text']}")
            
            while True:
                try:
                    choice = int(input("\nYour choice (1-4): ")) - 1
                    if 0 <= choice < len(question.options):
                        break
                    print("Invalid choice. Please enter 1-4.")
                except ValueError:
                    print("Please enter a number.")
            
            selected = question.options[choice]
            
            # Update trait scores
            for trait, score in selected['traits'].items():
                trait_scores[trait] += score
            
            # Update priorities
            if 'priority' in selected:
                priorities[selected['priority']] = priorities.get(selected['priority'], 0) + 1
            
            # Update cooperation and risk
            total_cooperation += selected.get('cooperation', 0)
            total_risk += selected.get('risk_tolerance', 0)
        
        # Determine primary and secondary traits
        sorted_traits = sorted(trait_scores.items(), key=lambda x: x[1], reverse=True)
        primary_trait = sorted_traits[0][0]
        secondary_trait = sorted_traits[1][0]
        
        # Normalize cooperation and risk
        cooperation_score = max(0, min(100, total_cooperation))
        risk_tolerance = max(0, min(100, total_risk))
        
        persona = PlayerPersona(
            primary_trait=primary_trait,
            secondary_trait=secondary_trait,
            priorities=priorities,
            risk_tolerance=risk_tolerance,
            cooperation_score=cooperation_score
        )
        
        self._display_persona_results(persona)
        
        return persona
    
    def _display_persona_results(self, persona: PlayerPersona):
        """Display persona analysis results"""
        print("\n" + "="*60)
        print("PERSONALITY PROFILE")
        print("="*60)
        
        trait_descriptions = {
            PersonaTrait.COLLABORATIVE: "You value cooperation and mutual benefit",
            PersonaTrait.COMPETITIVE: "You're determined to achieve the best outcome",
            PersonaTrait.RATIONAL: "You approach decisions logically and analytically",
            PersonaTrait.EMOTIONAL: "You're in touch with your feelings and express them",
            PersonaTrait.AVOIDANT: "You prefer to minimize conflict and move forward"
        }
        
        print(f"\nPrimary Style: {persona.primary_trait.value.upper()}")
        print(f"  → {trait_descriptions[persona.primary_trait]}")
        print(f"\nSecondary Style: {persona.secondary_trait.value.upper()}")
        print(f"  → {trait_descriptions[persona.secondary_trait]}")
        
        print(f"\nCooperation Level: {persona.cooperation_score}/100")
        print(f"Risk Tolerance: {persona.risk_tolerance}/100")
        
        if persona.priorities:
            print("\nYour Priorities:")
            sorted_priorities = sorted(persona.priorities.items(), 
                                     key=lambda x: x[1], reverse=True)
            for priority, score in sorted_priorities:
                print(f"  • {priority.capitalize()}: {'⭐' * score}")
        
        print("\nThis profile will influence your journey and outcomes.")
        input("\nPress Enter to continue...")


